              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Juan Carlos Pérez\",\n  \"dateOfBirth\": \"2000-05-15\",\n  \"nit\": \"1234567-8\",\n  \"cardNumber\": \"4111111111111111\",\n  \"cardExpiry\": \"2027-12-31\",\n  \"photoUrl\": \"https://example.com/foto.jpg\",\n  \"password\": \"nuevaPassword456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/students/me", "host": ["{{baseUrl}}"], "path": ["students", "me"] },
            "description": "Incluye el campo 'password' para actualizar la contraseña."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Pruebas de Seguridad",
      "description": "Verificar que los endpoints estén protegidos correctamente.",
      "item": [
        {
          "name": "Admin con token de Estudiante (debe dar 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard", "stats"] },
            "description": "Un estudiante NO puede acceder al dashboard admin. Esperado: 403 Forbidden."
          },
          "response": []
        },
        {
          "name": "Estudiante sin token (debe dar 403)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/students/me", "host": ["{{baseUrl}}"], "path": ["students", "me"] },
            "description": "Sin token no hay acceso. Esperado: 403 Forbidden."
          },
          "response": []
        },
        {
          "name": "Login Admin con credenciales incorrectas (debe dar 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@learnflow.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/admin/login", "host": ["{{baseUrl}}"], "path": ["auth", "admin", "login"] },
            "description": "Esperado: 401 Unauthorized."
          },
          "response": []
