              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "4. Cursos (Admin)",
      "description": "CRUD de cursos. Todos requieren token de admin.\nNota: al crear un curso necesitas los IDs de tipo, categoría y nivel (obtenidos del paso 3).",
      "item": [
        {
          "name": "Listar Cursos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] }
          },
          "response": []
        },
        {
          "name": "Buscar Curso por Título",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/courses?title=React",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [{ "key": "title", "value": "React" }]
            }
          },
          "response": []
        },
        {
          "name": "Crear Curso",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python para Data Science\",\n  \"productionYear\": 2025,\n  \"instructor\": \"Ana García\",\n  \"shortSummary\": \"Análisis de datos con Python y Pandas\",\n  \"description\": \"Curso completo de análisis de datos usando Python, Pandas, NumPy y Matplotlib para proyectos reales.\",\n  \"mediaUrl\": \"https://example.com/python-data-science\",\n  \"contentTypeId\": 1,\n  \"categoryId\": 1,\n  \"difficultyLevelId\": 2,\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/courses", "host": ["{{baseUrl}}"], "path": ["courses"] },
            "description": "Crea un curso. IDs de referencia:\ncontentTypeId: 1=Clase grabada, 2=Taller, 3=Conferencia\ncategoryId: 1=Programación, 2=Diseño, 3=Negocios\ndifficultyLevelId: 1=Principiante, 2=Intermedio, 3=Avanzado"
          },
          "response": []
        },
        {
          "name": "Ver Curso por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/courses/1", "host": ["{{baseUrl}}"], "path": ["courses", "1"] }
          },
          "response": []
        },
        {
          "name": "Actualizar Curso",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python para Data Science — Edición 2025\",\n  \"productionYear\": 2025,\n  \"instructor\": \"Ana García\",\n  \"shortSummary\": \"Análisis de datos actualizado con Python\",\n  \"description\": \"Versión actualizada del curso con los últimos cambios de Pandas 2.0.\",\n  \"mediaUrl\": \"https://example.com/python-data-science-v2\",\n  \"contentTypeId\": 1,\n  \"categoryId\": 1,\n  \"difficultyLevelId\": 2,\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/courses/2", "host": ["{{baseUrl}}"], "path": ["courses", "2"] },
            "description": "Cambia el id (2) por el id del curso a actualizar."
          },
          "response": []
        },
        {
          "name": "Eliminar Curso",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/courses/2", "host": ["{{baseUrl}}"], "path": ["courses", "2"] },
            "description": "Elimina permanentemente el curso. Cambia el id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Estudiante (Student Token)",
      "description": "Operaciones del perfil del estudiante. Requieren haber ejecutado 'Login Estudiante' primero.",
