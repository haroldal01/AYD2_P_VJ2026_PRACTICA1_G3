                  "raw": "{\n  \"name\": \"Webinar\",\n  \"description\": \"Seminario web actualizado\",\n  \"active\": true\n}"
                },
                "url": { "raw": "{{baseUrl}}/content-types/4", "host": ["{{baseUrl}}"], "path": ["content-types", "4"] }
              },
              "response": []
